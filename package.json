{
  "name": "sladit",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "vite-node --watch server/main.ts",
    "build": "vue-tsc --noEmit && vite build && vite build --ssr server/main.ts --outDir dist-server",
    "start": "NODE_ENV=production node dist-server/main.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "eval": "vite-node eval/run.ts",
    "eval:data": "vite-node eval/generate-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "exceljs": "^4.4.0",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "overrides": {
    "eslint-visitor-keys": "^4.2.1"
  }
}
