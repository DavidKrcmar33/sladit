{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "env.d.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "scripts/*.ts",
    "e2e/**/*",
    "src/**/*",
    "eval/**/*",
    "server/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
