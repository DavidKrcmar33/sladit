# Zkopíruj jako .env a doplň hodnoty. Soubor .env se do gitu nedává.
# Všechno tady čte jen server a měření, nic z toho se nedostane do prohlížeče.
# Proto žádný název nezačíná VITE_ (ty by Vite vložil do sestavené aplikace).

# Čtení rozpisů modelem: gemini (výchozí), nebo claude.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Druhé čtení nejistých podkladů. 'off' ho vypne, LLM_VERIFY_MODEL určí jiný model.
# LLM_VERIFY=off
# LLM_VERIFY_MODEL=

# Přihlášení přes Google (docs/BACKEND.md). Pro vývoj bez Googlu stačí GOOGLE_FAKE=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_FAKE=1

# Adresa aplikace. Ve vývoji Vite (npm run dev), v produkci https adresa z hostingu.
APP_ORIGIN=http://localhost:5173
# Port serveru. Hosting ho obvykle nastaví sám.
# PORT=8787

# Databáze Postgres. Bez ní (jen ve vývoji) běží PGlite v adresáři .local/pglite.
# DATABASE_URL=
# PGLITE_DIR=.local/pglite

# Kdo se smí přihlásit, e-maily oddělené čárkou. Prázdné = kdokoli s účtem Google.
# ALLOWED_EMAILS=
# Denní limity čtení modelem (podle času v Praze).
# READ_LIMIT_PER_USER_PER_DAY=30
# READ_LIMIT_TOTAL_PER_DAY=300
